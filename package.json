{
  "name": "chatpuccino",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Chat de roleplay estilo mensajería, compatible con personajes y lorebooks de SillyTavern, conectado a OpenRouter.",
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,green \"node --watch server/index.js\" \"vite\"",
    "build": "vite build",
    "start": "node server/index.js",
    "test": "node --test server/test",
    "check:i18n": "node scripts/check-i18n.mjs"
  },
  "dependencies": {
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0",
    "vite": "^5.4.0"
  }
}
